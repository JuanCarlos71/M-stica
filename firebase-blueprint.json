{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Store user profile and esoteric chart parameters",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "birthDate": { "type": "string" },
        "birthTime": { "type": "string" },
        "birthPlace": { "type": "string" },
        "zodiacSign": { "type": "string" },
        "ascendant": { "type": "string" },
        "lifePathNumber": { "type": "number" },
        "expressionNumber": { "type": "number" },
        "avatarUrl": { "type": "string" },
        "batterySaver": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "biometricEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName"]
    },
    "SavedReading": {
      "title": "SavedReading",
      "description": "Saved tarot or palmistry readings for the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "title", "summary"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "UserProfile",
      "description": "User profile document indexed by Firebase Auth UID"
    },
    "/users/{userId}/readings/{readingId}": {
      "entity": "SavedReading",
      "description": "User saved readings history"
    }
  }
}
